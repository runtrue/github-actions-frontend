# Copy this file to quick-start.env, then replace every CHANGE_ME value.
RUNTRUE_PUBLIC_ORIGIN=https://runtrue.example.com

# Edge mode. The default starts a dedicated Traefik on ports 80/443.
RUNTRUE_TRAEFIK_MODE=bundled
RUNTRUE_ACME_EMAIL=ops@example.com

# To reuse an existing Traefik instead, replace the two lines above with:
# RUNTRUE_TRAEFIK_MODE=existing
# RUNTRUE_TRAEFIK_NETWORK=proxy
# Optional if your Traefik uses different names:
# RUNTRUE_TRAEFIK_HTTP_ENTRYPOINT=web
# RUNTRUE_TRAEFIK_HTTPS_ENTRYPOINT=websecure
# RUNTRUE_TRAEFIK_CERT_RESOLVER=dynu
# RUNTRUE_TRAEFIK_ROUTER_NAME=runtrue

# GitHub.com or a GitHub Enterprise Server HTTPS origin, without a trailing slash.
RUNTRUE_GITHUB_WEB_ORIGIN=https://github.com
RUNTRUE_GITHUB_APP_ID=CHANGE_ME
RUNTRUE_GITHUB_APP_SLUG=CHANGE_ME
RUNTRUE_GITHUB_OAUTH_CLIENT_ID=CHANGE_ME
RUNTRUE_GITHUB_OAUTH_ADMIN_USER_IDS=CHANGE_ME

# Existing private files on this host. The installer copies them into private state.
RUNTRUE_GITHUB_APP_PRIVATE_KEY_SOURCE=/root/github-app.private-key.pem
RUNTRUE_GITHUB_OAUTH_CLIENT_SECRET_SOURCE=/root/github-app.oauth-secret

# Optional installation settings.
# RUNTRUE_INSTALL_ROOT=/opt/runtrue
# RUNTRUE_RUNTIME_UID=10001
# RUNTRUE_RUNTIME_GID=10001
# RUNTRUE_AUTOSCALER_CLAIM_ROOT=/var/lib/runtrue-autoscaler/runtrue/claims
# RUNTRUE_EDGE_HTTP_PORT=80
# RUNTRUE_EDGE_HTTPS_PORT=443
# RUNTRUE_EDGE_UPSTREAM_NAME=runtrue-frontend
# RUNTRUE_AUTOSCALER_IMAGE=ghcr.io/runtrue/github-actions-server:quickstart-autoscaler-latest
# RUNTRUE_RUNNER_IMAGE=ghcr.io/runtrue/runtrue-runner:latest
# RUNTRUE_RUNNER_RUNTIME_BUNDLE_IMAGE=ghcr.io/runtrue/runtrue-runner:quickstart-runtime-bundle-latest
# Quick-start publishes complete action logs even after a credential is
# released. Set false to suppress those logs. With true, trusted actions can
# accidentally or deliberately print credentials into the Runtrue log store.
# RUNTRUE_ALLOW_CREDENTIAL_TAINTED_LOGS=true
# RUNTRUE_AUTOSCALER_POOL_ID=pool-quickstart
# RUNTRUE_AUTOSCALER_TENANT_ID=quickstart
# RUNTRUE_AUTOSCALER_MINIMUM_WORKERS=0
# RUNTRUE_AUTOSCALER_MINIMUM_IDLE_WORKERS=0
# RUNTRUE_AUTOSCALER_MAXIMUM_WORKERS=2
# RUNTRUE_AUTOSCALER_IDLE_TIMEOUT_MS=30000

# Repository actions are built locally, admitted into the shared signed OCI
# store, and then executed by autoscaled runners. This setting allows Docker
# base images, not action repositories or commit IDs. Add only reviewed,
# immutable base-image references, separated by commas.
# RUNTRUE_REPOSITORY_ACTION_ALLOWED_BASE_IMAGES=node:22-bookworm-slim@sha256:53ada149d435c38b14476cb57e4a7da73c15595aba79bd6971b547ceb6d018bf
# RUNTRUE_REPOSITORY_ACTION_IMAGE_REPOSITORY=runtrue.local/repository-actions
# Shared or frequently used hosts should authenticate Docker Hub pulls to avoid
# its anonymous rate limit. Create a read-only access token and uncomment both.
# RUNTRUE_DOCKERHUB_USERNAME=CHANGE_ME
# RUNTRUE_DOCKERHUB_TOKEN_SOURCE=/root/dockerhub.token
