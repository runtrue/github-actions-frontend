# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5
ARG RUST_IMAGE=docker.io/library/rust:1.94.0-bookworm@sha256:365468470075493dc4583f47387001854321c5a8583ea9604b297e67f01c5a4f
ARG RUNTIME_IMAGE=docker.io/library/debian:bookworm-20250630-slim@sha256:6ac2c08566499cc2415926653cf2ed7c3aedac445675a013cc09469c9e118fdd

FROM ${RUST_IMAGE} AS build
ENV RUSTUP_TOOLCHAIN=1.94.0
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=runtrue-gha-cargo-registry-v1,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=runtrue-gha-cargo-git-v1,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=runtrue-gha-release-target-v1,target=/src/target,sharing=locked \
    --mount=type=secret,id=github_token \
    set -eu; \
    if test -s /run/secrets/github_token; then \
      git config --global credential.https://github.com.username x-access-token; \
      git config --global credential.helper \
        '!f() { if test "$1" = get; then echo username=x-access-token; printf "password="; cat /run/secrets/github_token; echo; fi; }; f'; \
    fi; \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
      cargo build --locked --release -p runtrue-server --bin runtrue-server; \
    install -D -m 0555 target/release/runtrue-server /out/runtrue-server; \
    rm -f /root/.gitconfig

FROM ${RUST_IMAGE} AS scm-tools
RUN set -eux; \
    test -x /usr/bin/git; \
    test -x /usr/lib/git-core/git-remote-http; \
    test -r /etc/ssl/certs/ca-certificates.crt; \
    multiarch="$(dpkg-architecture -qDEB_HOST_MULTIARCH)"; \
    install -d /out/usr/bin "/out/usr/lib/${multiarch}" /out/usr/share/git-core/templates /out/etc/ssl/certs; \
    cp -a /usr/bin/git /out/usr/bin/git; \
    cp -a /usr/lib/git-core /out/usr/lib/git-core; \
    cp -a /usr/share/git-core/templates/. /out/usr/share/git-core/templates/; \
    cp -a /etc/ssl/certs/ca-certificates.crt /out/etc/ssl/certs/ca-certificates.crt; \
    { ldd /usr/bin/git; ldd /usr/lib/git-core/git-remote-http; } \
      | awk '/=> \/[^ ]+/ { print $3 } /^\/[^	 ]+/ { print $1 }' \
      | sort -u \
      | while IFS= read -r library; do \
          case "$library" in \
            /lib*/ld-linux-*|/lib*/ld-musl-*|*/libc.so.*) continue ;; \
          esac; \
          cp -L "$library" "/out/usr/lib/${multiarch}/$(basename "$library")"; \
        done

FROM ${RUNTIME_IMAGE} AS server
ARG RUNTRUE_VERSION=0.1.0
ARG RUNTRUE_REVISION=unknown
LABEL org.opencontainers.image.title="Runtrue GitHub Actions control plane" \
      org.opencontainers.image.version="${RUNTRUE_VERSION}" \
      org.opencontainers.image.revision="${RUNTRUE_REVISION}" \
      org.opencontainers.image.source="https://github.com/runtrue/github-actions-frontend" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN groupadd --gid 10001 --system runtrue && \
    useradd --uid 10001 --gid 10001 --system --no-create-home \
      --home-dir /nonexistent --shell /usr/sbin/nologin runtrue && \
    install -d -o 10001 -g 10001 -m 0700 /var/lib/runtrue/server
COPY --from=build --chown=0:0 /out/runtrue-server /usr/local/bin/runtrue-server
COPY --from=scm-tools --chown=0:0 /out/ /
COPY --chown=0:0 product/server/healthcheck.sh /usr/local/bin/runtrue-healthcheck
RUN chmod 0555 /usr/local/bin/runtrue-server /usr/local/bin/runtrue-healthcheck /usr/bin/git && \
    /usr/bin/git --version
USER 10001:10001
WORKDIR /var/lib/runtrue/server
EXPOSE 8080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=4s --start-period=15s --retries=5 \
  CMD ["/usr/bin/timeout", "3", "/usr/local/bin/runtrue-healthcheck"]
ENTRYPOINT ["/bin/sh", "-c", "umask 077; exec /usr/local/bin/runtrue-server"]
